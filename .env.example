# Porta del server
PORT=3000

# Motore AI: API xAI (estensione del tuo account Grok).
# La CHIAVE API NON va qui: si inserisce nell'app (Account > Chiave xAI)
# e resta salvata solo sul tuo telefono. Il server la inoltra a xAI senza salvarla.
AI_BASE_URL=https://api.x.ai/v1
CHAT_MODEL=grok-4
IMAGE_MODEL=grok-imagine-image-2.0
# Modello per modifiche immagine (identità con riferimento, scambio volto)
IMAGE_EDIT_MODEL=grok-imagine-image-2.0
# Video (xAI asincrono). Lascia VIDEO_PATH vuoto per disattivare.
VIDEO_MODEL=grok-imagine-video-1.5-lite
VIDEO_PATH=/videos/generations
VIDEO_STATUS_PATH=/videos/{id}

# Metti true quando l'app è pubblicata in HTTPS (cookie "Secure")
COOKIE_SECURE=false

# Durata della sessione in giorni
SESSION_DAYS=30

# Accesso: niente password qui. Al primo avvio dall'app Nico e Luisa scelgono
# ciascuno il proprio PIN a 4 cifre (salvato come hash bcrypt in data/pins.json).
# Facoltativo ma consigliato online: codice extra richiesto SOLO per creare il PIN la prima volta.
SETUP_CODE=

# Copie di sicurezza automatiche in data/backups: quante tenerne (predefinito 20)
BACKUP_KEEP=20

# Azioni dell'avatar (v7): modello video, durata (2-8 s), risoluzione, limite di preparazioni l'ora per profilo
ACTION_VIDEO_MODEL=grok-imagine-video-1.5
ACTION_SECONDS=5
ACTION_RESOLUTION=480p
ACTION_MAX_HOUR=24

# v8.4 — profilo amministratore (può modificare personaggi, regole, impostazioni): nicola (predefinito) o luisa
# ADMIN_USER=nicola
# v8.4 — conversazione in tempo reale (Voice Agent API di xAI). Di solito non serve cambiarli.
# REALTIME_URL=wss://api.x.ai/v1/realtime
# REALTIME_MODEL=grok-voice-latest
# Modello veloce (senza ragionamento) per le risposte in chiamata classica; se non esiste si usa CHAT_MODEL
# CALL_MODEL=grok-4.20-0309-non-reasoning
